# ==========================================
# Kazakhstan Travel — Environment Variables
# ==========================================
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local SQLite database path (default: ./data/kazakhstan-travel.db)
KT_DB_PATH=./data/kazakhstan-travel.db

# Optional Production PostgreSQL URL (used with docker-compose.yml / pg adapter)
# DATABASE_URL=postgresql://kt_user:change_me@localhost:5432/kazakhstan_travel

# Auth / Session signing secret (generate a long random string in production)
AUTH_SECRET=dev-only-change-this-session-secret-in-production

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=travel32_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MANAGER_CHAT_ID=

# WhatsApp Cloud API (Meta Business Platform)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kt_whatsapp_verify_dev
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_PHONE=77775259885

# Optional Email / SMTP notification hook for manager alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MANAGER_NOTIFICATION_EMAIL=

# Optional Analytics (GA4 / GTM)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
